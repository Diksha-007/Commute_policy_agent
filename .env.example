# Copy to .env and fill in. .env is gitignored, so never commit real keys.

# Groq API key (free tier). Only needed for the live demo / real-LLM eval;
# tests use a fake LLM and pass without it.
groq_key=

# Secret used to sign demo JWTs (HS256). Change it outside local dev.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
